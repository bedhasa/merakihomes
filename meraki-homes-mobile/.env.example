# Replace YOUR_COMPUTER_LAN_IP with the development computer's current LAN IPv4.
# The Android emulator can use http://10.0.2.2:5002/api instead.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:5002/api
# Optional app-restricted map keys. Configure in .env.local before a native rebuild.
# Expo Go does not use these keys. A development or production native build is required.
# Restrict the Android key to package com.merakihomes.mobile plus the signing SHA-1:
# debug keystore for local `expo run:android`, and the EAS/Play upload key for store builds.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
