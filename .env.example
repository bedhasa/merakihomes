# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL via Docker Desktop. Replace the placeholder before starting the database.
POSTGRES_DB=meraki_homes
POSTGRES_USER=meraki_app
POSTGRES_PASSWORD=replace-this-before-running
# Optional pool size.
PG_POOL_SIZE=10
# Leave false/unset for the Railway private URL; Railway private networking is encrypted.
PG_SSL=false
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://meraki_app:replace-this-before-running@localhost:5432/meraki_homes

# Backend API
API_PORT=5000
# Server-only Railway API origin used by the Next.js proxy in production. Keep this unprefixed.
API_BASE_URL=
# Public origin used for absolute uploaded-image URLs.
PUBLIC_API_URL=
# Exact browser/mobile origins for direct API access; no wildcard.
API_CORS_ORIGINS=https://your-app.vercel.app
# Optional public URL for the separately hosted management portal.
NEXT_PUBLIC_MANAGEMENT_URL=
# Railway volume mount for uploaded images (mount the volume at this path).
UPLOAD_DIR=./backend/uploads
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional server-side Geoapify key for address suggestions. Without it, map pin
# selection and manual address entry remain available. Keep this key on the API
# server only. Do not add it to the mobile app.
GEOAPIFY_API_KEY=

# Agaz / Gemini. Keep GEMINI_API_KEY on the API server only.
# Recommended model for this app: gemini-3.8-flash. Change with GEMINI_MODEL.
# gemini-2.5-flash returns 404 for new Gemini API projects.
# GEMINI_FALLBACK_MODEL is used when the primary model is missing or overloaded.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
GEMINI_MAX_OUTPUT_TOKENS=700

# Optional public map tile settings. These are public URLs/attribution, not secrets.
# The default is OpenStreetMap's standard tile server. Follow the selected provider's
# attribution and usage policy before deploying at scale.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional initial staff administrator; used only by `npm run staff:bootstrap`.
BOOTSTRAP_STAFF_NAME=
BOOTSTRAP_STAFF_EMAIL=
BOOTSTRAP_STAFF_PASSWORD=

# Optional one-time staff creation CLI settings; keep passwords only in local/host secrets.
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_ROLE=operations

# Optional local SQLite source for the one-time import/compare tools.
SQLITE_SOURCE=./data/meraki.sqlite
