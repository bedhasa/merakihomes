{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev frontend --hostname 0.0.0.0 --port 3000",
    "dev:web": "npm run dev",
    "start:web": "next start frontend --hostname 0.0.0.0 --port 3000",
    "dev:management": "vite --config management/vite.config.ts --configLoader runner --host=0.0.0.0 --strictPort",
    "dev:api": "node backend/index.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node backend/migrate.mjs",
    "db:seed-demo": "node backend/seed-demo.mjs",
    "db:verify": "node backend/verify-db.mjs",
    "db:compare-sqlite": "node backend/compare-sqlite-catalogue.mjs",
    "db:smoke": "node backend/smoke-live.mjs",
    "env:local": "node scripts/ensure-local-env.mjs",
    "staff:bootstrap": "node backend/create-staff.mjs --bootstrap",
    "staff:create": "node backend/create-staff.mjs",
    "migrate:sqlite": "node backend/migrate-sqlite-to-postgres.mjs",
    "start": "node backend/index.mjs",
    "build": "next build frontend && vite build --config management/vite.config.ts --configLoader runner",
    "test": "node --import tsx --test frontend/src/booking/request.test.ts backend/*.test.mjs",
    "build:web": "next build frontend",
    "preview": "next start frontend --hostname 0.0.0.0 --port 3000",
    "clean": "node -e \"const fs=require('fs'); ['frontend/.next','dist-management','server.js'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true});}catch(e){}});\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.31",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
